# ==============================================================================
# 부산소프트웨어마이스터고(BSSM) 마이스터역량인증제 환경설정 템플릿 (.env.example)
# ==============================================================================
# 실제 운영 배포 시:
# 1. 이 파일을 복사하여 `.env` 생성: cp .env.example .env
# 2. 필수 시크릿 키(JWT, DB 패스워드, Redis 패스워드 등)를 반드시 안전한 난수로 교체하십시오.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 시스템 실행 환경 (Environment)
# ------------------------------------------------------------------------------
# 운영: production | 개발/테스트: development
ENVIRONMENT=production

# 신뢰할 수 있는 리버스 프록시 IP 대역 (IP 스푸핑 방어용, Nginx 또는 도커 네트워크 브릿지)
TRUSTED_PROXIES=127.0.0.1,nginx,172.16.0.0/12

# Cloudflare 프록시 경유 시에만 true로 설정하여 CF-Connecting-IP 헤더를 신뢰함
TRUST_CLOUDFLARE_HEADERS=false

# Docker Compose 프론트엔드 빌드 컨텍스트 경로 (예: ../FE 또는 ./fe)
FE_BUILD_CONTEXT=./fe

# 브라우저 CORS 허용 도메인 (콤마 구분, 프로덕션에서는 '*' 절대 금지)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:80,https://your-school-domain.hs.kr

# 파일 업로드 영속 저장소 경로
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 2. 데이터베이스 설정 (MySQL 8.0)
# ------------------------------------------------------------------------------
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=swMeister
# 최소 권한 원칙(Least Privilege)에 따라 root 대신 전용 애플리케이션 계정 사용 권장
DATABASE_USER=meister_app
# [중요] 반드시 복잡한 고난도 패스워드로 변경하십시오 (프로덕션 미설정 시 Fail-Fast 에러)
DATABASE_PASSWORD=change_this_to_a_secure_mysql_password_2026
MYSQL_ROOT_PASSWORD=change_this_to_a_secure_mysql_root_password_2026

# DB 커넥션 풀 크기 (고동시성 튜닝)
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=30

# ------------------------------------------------------------------------------
# 3. 인메모리 캐시 및 세션 락 (Redis 7)
# ------------------------------------------------------------------------------
# [중요] Redis requirepass 비밀번호
REDIS_PASSWORD=change_this_to_a_secure_redis_password_2026
REDIS_URL=redis://:change_this_to_a_secure_redis_password_2026@redis:6379/0
REDIS_POOL_MAX=30

# ------------------------------------------------------------------------------
# 4. JWT 인증 및 암호화 시크릿 (Security)
# ------------------------------------------------------------------------------
# [필수] openssl rand -hex 32 명령어로 최소 64바이트 이상의 고유한 무작위 난수를 생성하여 입력하십시오.
# 프로덕션 환경에서 change_this, generate_ 등의 예시 문자열 또는 32자 미만 사용 시 서버 기동이 차단됩니다.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240

# [필수] 초기 관리자 계정 가입용 마스터 인증 코드 (최소 16자 이상의 임의 난수 권장)
# 프로덕션 환경에서 설정되지 않거나 예시 패턴(change_this 등) 사용 시 서버 기동이 차단됩니다.
ADMIN_REGISTRATION_CODE=

# ------------------------------------------------------------------------------
# 5. 이메일 OTP 발송 설정 (Email Verification - .env 실사용 규격)
# ------------------------------------------------------------------------------
# 지원 프로바이더: smtp (표준 SMTP - Gmail 앱 비밀번호 권장), brevo (Brevo API), console (테스트용 콘솔)
EMAIL_PROVIDER=smtp

# (A) Gmail / 표준 SMTP 설정 (EMAIL_PROVIDER=smtp 일 때 사용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD="your_16_digit_gmail_app_password"
SMTP_FROM_NAME="부산소프트웨어마이스터고등학교"

# (B) Brevo API 설정 (EMAIL_PROVIDER=brevo 일 때 사용)
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=admin@bssm.hs.kr

# ------------------------------------------------------------------------------
# 6. NEIS 공공 데이터 포털 API 연동
# ------------------------------------------------------------------------------
# 교육정보 개방 포털(https://open.neis.go.kr)에서 발급받은 인증키 (미입력 시 모의 검증 모드로 자동 폴백)
NEIS_API_KEY=

# ------------------------------------------------------------------------------
# 7. AI 서비스 설정 (LLM Services - .env 실사용 AI_API_KEY 및 Multi-Provider)
# ------------------------------------------------------------------------------
# 기본 프로바이더: gemini | openai | claude | compatible
AI_PROVIDER=gemini

# [Google Gemini / 단일 통합 AI Key (.env 호환 규격)]
# .env에서 사용 중인 단일 AI API 키 (Gemini Flash 모델 연동)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 교사용 / 관리자용 전용 분리 키 (선택사항, 미지정 시 기본 AI_API_KEY/GEMINI_API_KEY 자동 상속)
TEACHER_AI_API_KEY=
GEMINI_TEACHER_MODEL=gemini-3.8-flash
ADMIN_AI_API_KEY=
GEMINI_ADMIN_MODEL=gemini-3.8-flash

# [OpenAI] (AI_PROVIDER=openai 일 때)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# TEACHER_AI_MODEL=gpt-4o
# ADMIN_AI_MODEL=gpt-4o

# [Anthropic Claude] (AI_PROVIDER=claude 일 때)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# [OpenAI-Compatible Custom Endpoint] (Groq, vLLM, Ollama, DeepSeek 등)
# AI_BASE_URL=https://api.groq.com/openai/v1
# COMPATIBLE_AI_API_KEY=
# COMPATIBLE_AI_MODEL=
