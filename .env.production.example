# ==============================================================================
# .env.production.example - 마이스터 역량인증제 프로덕션 필수 환경 변수 템플릿
# ==============================================================================
# 주의: 이 파일을 .env.production 파일로 복사한 뒤, 실제 보안 비밀값으로 채워 넣으세요.
#      절대로 비밀번호나 시크릿 키가 포함된 .env 파일을 Git에 커밋하지 마세요.

# 1. 애플리케이션 실행 모드
ENVIRONMENT=production
PROD=true
PORT=8000

# 2. MySQL 8.0 데이터베이스 접속 정보
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=meister_app
# [필수 변경] 강력한 데이터베이스 암호 (최소 16자 이상 영문/숫자/특수문자 조합)
DATABASE_PASSWORD=CHANGE_THIS_TO_SECURE_STRONG_DB_PASSWORD_2026!
DATABASE_NAME=swMeister
DATABASE_POOL_MIN=10
DATABASE_POOL_MAX=50

# 3. Redis 7.0 인메모리 세션 & 락 캐시 접속 정보
REDIS_URL=redis://:CHANGE_THIS_TO_SECURE_REDIS_PASSWORD_2026!@redis:6379/0
# [필수 변경] 강력한 Redis 인증 비밀번호
REDIS_PASSWORD=CHANGE_THIS_TO_SECURE_REDIS_PASSWORD_2026!
REDIS_POOL_MAX=50

# 4. JWT 인증 및 보안 시크릿
# [필수 변경] openssl rand -hex 32 로 생성한 64바이트 16진수 랜덤 문자열
JWT_SECRET=CHANGE_THIS_TO_RANDOM_GENERATED_64_CHAR_HEX_SECRET_STRING_2026
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# [필수 변경] 관리자 최초 계정 가입 시 사용하는 16자 이상의 안전한 승인 코드
ADMIN_REGISTRATION_CODE=CHANGE_THIS_TO_SECURE_ADMIN_REG_CODE_2026!

# 5. 스토리지 백엔드 설정 (local | s3 | minio | r2)
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads
# S3 또는 MinIO 사용 시 아래 항목 설정
# S3_BUCKET_NAME=meister-prod-uploads
# S3_ENDPOINT_URL=https://s3.ap-northeast-2.amazonaws.com
# S3_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 6. NEIS 교육행정정보시스템 오픈 API 키 (학급/학사일정 교차 검증용)
NEIS_API_KEY=

# 7. AI 서비스 및 Fallback 엔진 (gemini | openai | claude)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
